---
import { projects, type Project } from "../../data/projects";
import "../../styles/global.css";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: Project;
};

const { project } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const photo = (file: string) => `${base}photos/${file}`;
const projectIndexHref = `${base}#projects`;
const projectContextHref = "#project-context";
const handle = "@lyubmyr_rudko";
const linkedInUrl = "https://www.linkedin.com/in/lrudko/";
const telegramUrl = "https://t.me/lyubomyr_rudko_work";
const email = "rudkolg@gmail.com";
const emailUrl = `mailto:${email}`;
const phoneUrl = "tel:+380970480847";

const navItems = [
  { label: "Home", href: base },
  { label: "Projects", href: projectIndexHref },
  { label: "CV", href: `${base}cv/` },
  { label: "Contact", href: "#contact" },
];

const contactLinks = [
  {
    label: "LinkedIn",
    value: handle,
    href: linkedInUrl,
    valueHref: linkedInUrl,
    external: true,
    valueExternal: true,
  },
  {
    label: "Telegram",
    value: handle,
    href: telegramUrl,
    valueHref: telegramUrl,
    external: true,
    valueExternal: true,
  },
  {
    label: "Email",
    value: email,
    href: emailUrl,
    valueHref: emailUrl,
    external: false,
    valueExternal: false,
  },
  {
    label: "Phone",
    value: "+380 970 480 847",
    href: phoneUrl,
    valueHref: phoneUrl,
    external: false,
    valueExternal: false,
  },
];

const footerSocialLinks = [
  { label: "Telegram", href: telegramUrl, icon: "telegram" },
  { label: "LinkedIn", href: linkedInUrl, icon: "linkedin" },
];

const heroParagraphs = project.heroParagraphs ?? [project.description];
const renderedDetailSections = project.detailSections ?? [];
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${project.title}: ${project.description}`}
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{project.title} - Project Details</title>
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <main class="min-h-screen bg-background">
      <header
        class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm"
      >
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
          <div
            class="flex min-h-20 flex-col gap-4 py-4 md:flex-row md:items-center md:justify-between md:gap-8"
          >
            <a
              class="text-lg font-medium tracking-tight text-foreground"
              href={base}
            >
              Lyubomyr Rudko
            </a>

            <nav
              aria-label="Primary navigation"
              class="flex gap-6 overflow-x-auto pb-1 text-sm md:gap-10 md:overflow-visible md:pb-0"
            >
              {
                navItems.map((item) => (
                  <a
                    class="shrink-0 text-muted-foreground transition-colors hover:text-foreground"
                    href={item.href}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </header>

      <section class="border-b border-border py-8">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
          <nav
            aria-label="Breadcrumb"
            class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground"
          >
            <a
              class="underline-offset-4 transition-colors hover:text-foreground hover:underline"
              href={base}
            >
              Home
            </a>
            <span aria-hidden="true">/</span>
            <a
              class="underline-offset-4 transition-colors hover:text-foreground hover:underline"
              href={projectIndexHref}
            >
              Projects
            </a>
            <span aria-hidden="true">/</span>
            <span class="text-foreground">{project.title}</span>
          </nav>
        </div>
      </section>

      <section class="border-b border-border py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
          <div class="grid items-start gap-12 lg:grid-cols-12">
            <div class="space-y-8 lg:col-span-7">
              <div>
                <p
                  class="mb-4 text-sm uppercase tracking-widest text-muted-foreground"
                >
                  Project {project.index}
                </p>
                <h1
                  class="text-5xl font-medium leading-[1.05] tracking-tight text-foreground md:text-6xl"
                >
                  {project.title}
                </h1>
                <p class="mt-4 text-xl text-muted-foreground">
                  {project.subtitle}
                </p>
              </div>

              <div class="max-w-3xl space-y-4">
                {
                  heroParagraphs.map((paragraph) => (
                    <p class="text-lg leading-relaxed text-muted-foreground md:text-xl">
                      {paragraph}
                    </p>
                  ))
                }
              </div>

              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
                  href={projectContextHref}
                >
                  Read more...
                </a>
                <a
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-medium transition-colors hover:bg-secondary"
                  href={project.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.referenceLabel}
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 7h10v10"></path>
                    <path d="M7 17 17 7"></path>
                  </svg>
                </a>
              </div>
            </div>

            <div class="lg:col-span-5">
              <div
                class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-border bg-secondary"
              >
                <img
                  alt={`${project.title} project image`}
                  class="absolute inset-0 h-full w-full object-cover"
                  decoding="async"
                  src={photo(project.imageFile)}
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
          <div class="grid gap-12 lg:grid-cols-12">
            <aside class="lg:col-span-4">
              <div class="sticky top-28 rounded-2xl border border-border p-8">
                {
                  project.skills ? (
                    <>
                      <p class="mb-4 text-sm uppercase tracking-widest text-muted-foreground">
                        Skills Demonstrated
                      </p>
                      <h2 class="text-2xl font-medium tracking-tight text-foreground">
                        Engineering Scope
                      </h2>
                      <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted-foreground">
                        {project.skills.map((skill) => (
                          <li class="border-t border-border pt-3 first:border-t-0 first:pt-0">
                            {skill}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : null
                }
              </div>
            </aside>

            <div class="space-y-6 lg:col-span-8">
              {
                renderedDetailSections.map((section) => (
                  <section
                    id={
                      section.title === "Project Context"
                        ? "project-context"
                        : undefined
                    }
                    class="scroll-mt-28 rounded-2xl border border-border bg-background p-8"
                  >
                    <div class="mb-6 flex items-center gap-4">
                      <span class="font-mono text-sm text-muted-foreground">
                        {section.index}
                      </span>
                      <h2 class="text-2xl font-medium tracking-tight text-foreground">
                        {section.title}
                      </h2>
                    </div>
                    <div class="space-y-5">
                      {section.paragraphs?.map((paragraph) => (
                        <p class="text-lg leading-relaxed text-muted-foreground">
                          {paragraph}
                        </p>
                      ))}
                      {section.items && (
                        <ul class="list-disc space-y-2 pl-5 text-muted-foreground">
                          {section.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      )}
                      {section.subsections?.map((subsection) => (
                        <div class="border-t border-border pt-5">
                          <h3 class="mb-3 text-lg font-medium text-foreground">
                            {subsection.title}
                          </h3>
                          <div class="space-y-3">
                            {subsection.paragraphs?.map((paragraph) => (
                              <p class="leading-relaxed text-muted-foreground">
                                {paragraph}
                              </p>
                            ))}
                            {subsection.items && (
                              <ul class="list-disc space-y-2 pl-5 text-muted-foreground">
                                {subsection.items.map((item) => (
                                  <li>{item}</li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </section>
                ))
              }

              {
                project.pageBlocks && (
                  <section class="rounded-2xl border border-border bg-secondary p-8">
                    <div class="mb-8">
                      <p class="mb-4 text-sm uppercase tracking-widest text-muted-foreground">
                        {project.pageBlocksEyebrow ?? "Project Overview"}
                      </p>
                      <h2 class="text-2xl font-medium tracking-tight text-foreground">
                        {project.pageBlocksHeading ?? "Summary and Highlights"}
                      </h2>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                      {project.pageBlocks.map((block) => (
                        <div class="rounded-xl border border-border bg-background p-6">
                          <h3 class="text-lg font-medium text-foreground">
                            {block.title}
                          </h3>
                          {block.text && (
                            <p class="mt-3 leading-relaxed text-muted-foreground">
                              {block.text}
                            </p>
                          )}
                          {block.items && (
                            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted-foreground">
                              {block.items.map((item) => (
                                <li>{item}</li>
                              ))}
                            </ul>
                          )}
                        </div>
                      ))}
                    </div>
                  </section>
                )
              }
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="border-t border-border py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
          <div class="grid gap-16 lg:grid-cols-12">
            <div class="lg:col-span-5">
              <p
                class="mb-4 text-sm uppercase tracking-widest text-muted-foreground"
              >
                Contact
              </p>
              <h2
                class="mb-8 text-4xl font-medium tracking-tight text-foreground md:text-5xl"
              >
                Work With Me
              </h2>
              <p class="mb-8 text-lg leading-relaxed text-muted-foreground">
                Hire me for full-stack development, product architecture,
                technical leadership, codebase audits, or modernization work. I
                help teams turn complex ideas and legacy systems into clear,
                scalable, maintainable software.
              </p>
              <a
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 font-medium text-primary-foreground transition-opacity hover:opacity-90"
                href={telegramUrl}
              >
                Hire {handle}
                <svg
                  aria-hidden="true"
                  class="h-[18px] w-[18px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 7h10v10"></path>
                  <path d="M7 17 17 7"></path>
                </svg>
              </a>
            </div>

            <div class="lg:col-span-7">
              <h3
                class="mb-8 text-sm uppercase tracking-widest text-muted-foreground"
              >
                Contact Channels
              </h3>
              <div class="space-y-2">
                {
                  contactLinks.map((link) => (
                    <div
                      class="group flex items-center justify-between rounded-xl border border-border p-6 transition-all hover:border-foreground"
                    >
                      <div>
                        <a
                          class="font-medium text-foreground underline-offset-4 hover:underline"
                          href={link.href}
                          target={link.external ? "_blank" : undefined}
                          rel={link.external ? "noopener noreferrer" : undefined}
                        >
                          {link.label}
                        </a>
                        <p class="text-sm text-muted-foreground">
                          <a
                            class="underline-offset-4 hover:text-foreground hover:underline"
                            href={link.valueHref}
                            target={link.valueExternal ? "_blank" : undefined}
                            rel={link.valueExternal ? "noopener noreferrer" : undefined}
                          >
                            {link.value}
                          </a>
                        </p>
                      </div>
                      <a
                        aria-label={`Open ${link.label}`}
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                      >
                        <svg
                          aria-hidden="true"
                          class="h-5 w-5 text-muted-foreground transition-all group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-foreground"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M7 7h10v10"></path>
                          <path d="M7 17 17 7"></path>
                        </svg>
                      </a>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <footer class="mt-32 border-t border-border pt-8">
            <div
              class="flex flex-col items-center justify-between gap-4 text-sm text-muted-foreground md:flex-row"
            >
              <p>&copy; 2026 Lyubomyr Rudko</p>
              <ul class="flex items-center gap-3" aria-label="Social links">
                {
                  footerSocialLinks.map((link) => (
                    <li>
                      <a
                        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-muted-foreground transition-all hover:border-foreground hover:text-foreground"
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={link.label}
                        title={link.label}
                      >
                        {link.icon === "telegram" && (
                          <svg
                            aria-hidden="true"
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                          >
                            <path d="M21.9 4.6 18.6 20c-.2 1-.8 1.2-1.6.8l-4.8-3.6-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.7 1.8 12.2c-1-.3-1-1 .2-1.5L20.4 3.6c.8-.3 1.6.2 1.5 1Z" />
                          </svg>
                        )}
                        {link.icon === "linkedin" && (
                          <svg
                            aria-hidden="true"
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect width="4" height="12" x="2" y="9" />
                            <circle cx="4" cy="4" r="2" />
                          </svg>
                        )}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </footer>
        </div>
      </section>
    </main>
  </body>
</html>
